# Root-level Dockerfile for neurosys-frontend on Railway

FROM node:18-alpine
WORKDIR /app

# Copy package files from neurosys-frontend subfolder
COPY neurosys-frontend/package*.json ./
RUN npm install

# Copy neurosys-frontend source code
COPY neurosys-frontend/ .

ARG VITE_API_BASE_URL=https://realtmesystemmonitoring-production.up.railway.app/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

EXPOSE 3000
CMD ["npx", "serve", "-s", "dist", "-l", "3000"]
